      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(llm_gateway_request_duration_ms_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_gateway_request_duration_ms_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_gateway_request_duration_ms_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "End-to-end latency percentiles",
      "type": "timeseries"
    },
