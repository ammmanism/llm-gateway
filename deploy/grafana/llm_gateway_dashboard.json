      "targets": [ { "expr": "sum(rate(llm_gateway_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A" } ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
